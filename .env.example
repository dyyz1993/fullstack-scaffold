# ===========================================
# Database Configuration
# ===========================================
# Supported drivers: sqlite, mysql, d1
DB_DRIVER=sqlite

# ===========================================
# SQLite Configuration (Local Development)
# ===========================================
SQLITE_PATH=./data/app.db

# ===========================================
# MySQL Configuration (Production Server)
# ===========================================
# Uncomment and configure when using MySQL
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=biomimic_app

# ===========================================
# Cloudflare D1 Configuration
# ===========================================
# D1 is configured via wrangler.toml, not env vars
# The binding is automatically injected by Cloudflare Workers

# ===========================================
# Security Configuration
# ===========================================
# JWT 密钥（生产环境必填）
# JWT_SECRET_KEY=your-secure-secret-key-here
# JWT 过期时间
# JWT_EXPIRES_IN=7d

# 文件存储密钥（生产环境必填）
# FILE_SECRET_KEY=your-file-secret-key-here
# 临时文件过期时间（毫秒）
# TEMP_FILE_TTL=3600000
# 最大文件大小（字节，默认10MB）
# MAX_FILE_SIZE=10485760

# ===========================================
# External Services Configuration
# ===========================================
# 头像服务URL
# AVATAR_SERVICE_URL=https://api.dicebear.com/7.x/avataaars/svg

# API 服务地址（CLI 工具使用）
# API_URL=http://localhost:3000

# ===========================================
# Development Only
# ===========================================
# 是否启用开发Token（仅开发环境，生产环境必须为false）
# ENABLE_DEV_TOKENS=false

# ===========================================
# Application Configuration
# ===========================================
# API Documentation (set to false in production)
ENABLE_DOCS=true

# Mock Mode (development)
VITE_USE_MOCK_SERVER=true

# Server Port
PORT=3010

# ===========================================
# LLM & Sandbox Configuration
# ===========================================
# 启用 PI 配置（启用后将使用 Sandbox 安全沙箱）
# 生产环境建议设置为 true
# USE_PI_CONFIG=true

# Mock LLM 模式（开发环境使用，禁用 Sandbox）
# 生产环境必须设置为 false
# MOCK_LLM=false
